# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME_PROD=traveler_db
DB_USER=traveler_user
DB_PASSWORD=change_me_strong_password_123
DB_POOL=200

# ASP.NET Core Application Configuration
APP_PORT=5000
ASPNETCORE_ENVIRONMENT=Production
LOG_LEVEL=Information
